# Normalize all text files to LF in the repo so switching between
# macOS and Windows does not produce spurious CRLF/LF diffs.
* text=auto eol=lf

# Scripts that must stay LF regardless of platform
*.lua    text eol=lf
*.sh     text eol=lf
*.ps1    text eol=lf
*.md     text eol=lf
Makefile text eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.flac binary
*.love binary
*.zip  binary
*.exe  binary
